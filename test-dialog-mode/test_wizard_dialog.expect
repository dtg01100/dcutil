#!/home/linuxbrew/.linuxbrew/bin/expect

# Dialog mode wizard testing
# Tests wizard functionality with dialog interface

set timeout 120
set dcutil_cmd [lindex $argv 0]
if {$dcutil_cmd eq ""} {
    set dcutil_cmd "./dcutil"
}
set dcutil_cmd [file normalize $dcutil_cmd]

# Test dialog mode wizard functionality
proc test_wizard_dialog_mode {} {
    global timeout dcutil_cmd
    
    puts "🧪 Testing dcutil wizard in DIALOG mode..."
    
    # Prepare isolated environment
    set temp_home [exec mktemp -d /tmp/dcutil_wizard_dialog.XXXXXX]
    set project_dir "$temp_home/project"
    file mkdir "$project_dir/.devcontainer"
    
    # Create a devcontainer CLI stub that writes a config file when invoked with templates apply
    set temp_bin "$temp_home/bin"
    file mkdir $temp_bin
    set dev_stub "$temp_bin/devcontainer"
    set fh [open $dev_stub "w"]
    puts $fh {#!/bin/bash
if [[ "$1" == "templates" && "$2" == "apply" ]]; then
  mkdir -p .devcontainer
  echo '{"name":"test","image":"ubuntu:22.04"}' > .devcontainer/devcontainer.json
  echo 'Template applied successfully'
  exit 0
fi
echo "devcontainer CLI stub: args=$*"
}
    close $fh
    exec chmod +x $dev_stub
    
    # Run wizard in dialog mode
    set env(HOME) $temp_home
    set env(CI) 1
    set env(DC_TEST_MODE) 1
    # Add temp_bin to PATH if PATH exists, otherwise just use temp_bin and common paths
    if {[info exists env(PATH)]} {
        set env(PATH) "$temp_bin:$env(PATH)"
    } else {
        set env(PATH) "$temp_bin:/usr/local/bin:/usr/bin:/bin"
    }
    
    cd $project_dir
    spawn env DCUTIL_FORCE_DIALOG=1 $dcutil_cmd init wizard
    
    expect {
        "dcutil Wizard - Step 1" {
            puts "✓ Wizard launched in dialog mode"
            
            # Wait for project type detection and use default (option 1)
            expect {
                "Automatically detected:" {
                    puts "✓ Project type detected in dialog mode"
                    send "\r"
                    
                    expect {
                        "Select Features" {
                            puts "✓ Feature selection reached in dialog mode"
                            # Finish selection (empty)
                            send "\r"
                            
                            expect {
                                "Advanced Configuration" {
                                    puts "✓ Advanced configuration reached in dialog mode"
                                    # Use default name
                                    send "\r"
                                    
                                    expect {
                                        "Enable SSH propagation?" {
                                            puts "✓ SSH prompt reached"
                                            # No
                                            send "n"
                                            
                                            expect {
                                                "Add VS Code customizations" {
                                                    puts "✓ VS Code customizations prompt reached"
                                                    # No
                                                    send "n"
                                                    
                                                    expect {
                                                        "successfully" {
                                                            puts "✓ Configuration created successfully"
                                                        }
                                                        timeout {
                                                            puts "✗ FAIL: Final success message not found"
                                                            exit 1
                                                        }
                                                    }
                                                }
                                                timeout {
                                                    puts "✗ FAIL: VS Code prompt not found"
                                                    exit 1
                                                }
                                            }
                                        }
                                        timeout {
                                            puts "✗ FAIL: SSH prompt not found"
                                            exit 1
                                        }
                                    }
                                }
                                timeout {
                                    puts "✗ FAIL: Advanced configuration failed in dialog mode"
                                    exit 1
                                }
                            }
                        }
                        timeout {
                            puts "✗ FAIL: Feature selection failed in dialog mode"
                            exit 1
                        }
                    }
                }
                timeout {
                    puts "✗ FAIL: Project type detection failed in dialog mode"
                    exit 1
                }
            }
        }
        timeout {
            puts "✗ FAIL: Wizard failed to launch in dialog mode"
            exit 1
        }
    }
    
    puts "✅ Dialog mode wizard tests PASSED"
}

# Main execution
puts "========================================="
puts "🧪 Dialog Mode Wizard Testing"
puts "========================================="

test_wizard_dialog_mode

puts "🎉 Dialog mode wizard tests completed successfully!"