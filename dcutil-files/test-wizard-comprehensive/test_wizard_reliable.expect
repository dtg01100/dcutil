#!/usr/bin/env expect

# Enhanced reliability test for dcutil wizard
# Strategies:
# 1. Use longer timeouts for network/I/O heavy operations
# 2. Add error handling and specific failure messages
# 3. Clean environment before each test
# 4. Use more flexible regex matching

set timeout 60
set dcutil_cmd "./dcutil"

# Colors for output
set RED "\033[0;31m"
set GREEN "\033[0;32m"
set YELLOW "\033[0;33m"
set NC "\033[0m"

proc clean_test_environment {} {
    catch {exec rm -rf .devcontainer}
    catch {exec rm -rf .git}
    return 1
}

proc verify_devcontainer_created {} {
    return [file exists ".devcontainer/devcontainer.json"]
}

# HIGH RISK: Wizard with detected template flow
proc test_wizard_detected_template_flow {} {
    global timeout dcutil_cmd
    
    puts "🔴 HIGH RISK: Testing wizard with detected template..."
    
    if {![clean_test_environment]} {
        puts "  ⚠ Skipping - cannot clean environment"
        return 0
    }
    
    # Create a dummy project that will be detected as Ubuntu
    # (dcutil detects ubuntu by default or based on certain files)
    
    spawn $dcutil_cmd init wizard
    
    expect {
        "Welcome to dcutil!" {
            expect "Press Enter to continue"
            send "\r"
            
            expect "Quick start guide"
            expect "Press Enter to continue"
            send "\r"
            
            expect {
                "Project Type Detection" {
                    puts "  ✓ Project type detection shown"
                    
                    # Should show detected template
                    expect {
                        "Automatically detected:" {
                            puts "  ✓ Template detected"
                            
                            # Proceed with defaults
                            expect {
                                "Creating configuration" {
                                    puts "  ✓ Creating configuration"
                                    
                                    expect {
                                        "Configuration complete" {
                                            puts "  ✓ Configuration completed"
                                            # Process might exit here or wait for enter
                                            expect {
                                                "Press Enter to continue" {
                                                    send "\r"
                                                }
                                                eof {
                                                    puts "  ✓ Wizard finished"
                                                }
                                                timeout {
                                                    puts "  ⚠ Wizard final prompt timeout"
                                                }
                                            }
                                        }
                                        eof {
                                            puts "  ✓ Wizard finished"
                                        }
                                        timeout {
                                            puts "  ⚠ Configuration may have completed (timeout)"
                                        }
                                    }
                                }
                                eof {
                                    puts "  ✓ Wizard finished without explicit completion message"
                                }
                                timeout {
                                    puts "  ✗ FAIL: Configuration did not complete"
                                    return 0
                                }
                            }
                        }
                        "Project already configured" {
                            puts "  ℹ Project already configured"
                            return 1
                        }
                        timeout {
                            puts "  ✗ FAIL: Project type detection not shown"
                            return 0
                        }
                    }
                }
                timeout {
                    puts "  ✗ FAIL: Quick start not shown"
                    return 0
                }
            }
        }
        "Project already configured" {
            puts "  ℹ Project already configured, skipping"
            return 1
        }
        timeout {
            puts "  ✗ FAIL: Wizard did not start"
            return 0
        }
    }
    
    # Process might have already exited
    catch {expect eof}
    
    # Verify result
    if {[verify_devcontainer_created]} {
        puts "✅ Wizard detected template flow PASSED"
        return 1
    } else {
        puts "  ⚠ Wizard completed but verification failed"
        return 0
    }
}

# HIGH RISK: Testing wizard with manual selection
proc test_wizard_manual_template_flow {} {
    global timeout dcutil_cmd
    
    puts "🔴 HIGH RISK: Testing wizard with manual selection..."
    
    if {![clean_test_environment]} {
        puts "  ⚠ Skipping - cannot clean environment"
        return 0
    }
    
    spawn $dcutil_cmd init wizard
    
    expect {
        "Welcome to dcutil!" {
            expect "Press Enter to continue"
            send "\r"
            
            expect "Quick start guide"
            expect "Press Enter to continue"
            send "\r"
            
            expect {
                "Project Type Detection" {
                    # Wait for selection prompt
                    expect {
                        -re "Please select|What would you like" {
                            send "2\r"  ;# Choose manual selection
                            puts "  ✓ Selected manual template choice"
                        }
                        timeout {
                            puts "  ✗ FAIL: No selection prompt for manual"
                            return 0
                        }
                    }
                    
                    # Handle template list display
                    expect {
                        -re "Available templates|Select a template" {
                            puts "  ✓ Template list shown"
                            
                            # Wait for input prompt
                            expect {
                                -re "Enter number|Select" {
                                    send "1\r"  ;# Select first template
                                    puts "  ✓ Selected template"
                                }
                                timeout {
                                    puts "  ✗ FAIL: No template selection prompt"
                                    return 0
                                }
                            }
                            
                            # Handle potential configuration questions
                            set config_done 0
                            while {$config_done == 0} {
                                expect {
                                    "Creating configuration" {
                                        puts "  ✓ Creating configuration started"
                                        # Stay in loop until complete or eof
                                    }
                                    -re "Configuration complete" {
                                        puts "  ✓ Configuration completed"
                                        send "\r"
                                        set config_done 1
                                    }
                                    -re "Enter|Select|Choose" {
                                        puts "  ✓ Answering configuration question"
                                        send "\r"  ;# Use default
                                    }
                                    eof {
                                        puts "  ✓ Wizard completed"
                                        set config_done 1
                                    }
                                    timeout {
                                        puts "  ⚠ Configuration timeout (may be complete)"
                                        set config_done 1
                                    }
                                }
                            }
                        }
                        timeout {
                            puts "  ✗ FAIL: Template list not shown"
                            return 0
                        }
                    }
                }
                "Creating configuration" {
                    puts "  ✓ Creating configuration"
                    expect {
                        -re "Configuration complete" {
                             puts "  ✓ Configuration completed"
                             send "\r"
                        }
                        timeout {
                             puts "  ⚠ Configuration timeout"
                        }
                        eof {
                             puts "  ✓ Wizard finished"
                        }
                    }
                }
                timeout {
                    puts "  ✗ FAIL: Manual selection failed"
                    return 0
                }
            }
        }
        "Project already configured" {
            puts "  ℹ Project already configured"
            return 1
        }
        eof {
            puts "  ✗ FAIL: Wizard exited unexpectedly"
            return 0
        }
        timeout {
            puts "  ✗ FAIL: Wizard did not start"
            return 0
        }
    }
    
    # Process might have already exited
    catch {expect eof}
    
    # Verify result
    if {[verify_devcontainer_created]} {
        puts "✅ Wizard manual template flow PASSED"
        return 1
    } else {
        puts "  ⚠ Wizard completed but verification failed"
        return 0
    }
}

# MEDIUM RISK: Wizard interruption and recovery
proc test_wizard_interruption_handling {} {
    global timeout dcutil_cmd
    
    puts "🟡 MEDIUM RISK: Testing wizard interruption handling..."
    
    if {![clean_test_environment]} {
        puts "  ⚠ Skipping - cannot clean environment"
        return 0
    }
    
    spawn $dcutil_cmd init wizard
    
    expect {
        "Welcome to dcutil!" {
            # Start wizard then interrupt
            after 500
            send "\003"  ;# Send Ctrl+C
            
            expect {
                eof {
                    puts "  ✓ Wizard interrupted cleanly"
                }
                timeout {
                    puts "  ⚠ Wizard may not handle interruption"
                }
            }
        }
        timeout {
            puts "  ✗ FAIL: Wizard interruption test failed"
            return 0
        }
    }
    
    catch {expect eof}
    
    # Verify no partial configuration (or at least valid state)
    # Note: dcutil might create some files before interruption
    
    puts "✅ Wizard interruption handling PASSED"
    return 1
}

# MEDIUM RISK: Wizard with existing configuration
proc test_wizard_existing_config_handling {} {
    global timeout dcutil_cmd
    
    puts "🟡 MEDIUM RISK: Testing wizard with existing config..."
    
    # Create a minimal devcontainer.json
    catch {exec mkdir -p .devcontainer}
    set f [open ".devcontainer/devcontainer.json" w]
    puts $f "{\"name\": \"test\"}"
    close $f
    
    spawn $dcutil_cmd init wizard
    
    expect {
        "Error: Devcontainer configuration already exists" {
            puts "  ✓ Existing configuration detected correctly"
            return 1
        }
        "Welcome to dcutil!" {
            puts "  ✗ FAIL: Did not detect existing configuration"
            return 0
        }
        timeout {
            puts "  ✗ FAIL: Wizard failed to respond"
            return 0
        }
    }
    
    catch {expect eof}
}

# LOW RISK: Wizard help command
proc test_wizard_help {} {
    global timeout dcutil_cmd
    
    puts "🟢 LOW RISK: Testing wizard help..."
    
    spawn $dcutil_cmd init --help
    
    expect {
        "Initialize a devcontainer" {
            puts "  ✓ Wizard help shown"
            return 1
        }
        timeout {
            puts "  ✗ FAIL: Help command timed out"
            return 0
        }
    }
    
    catch {expect eof}
}

# Main test execution
puts "========================================="
puts "🧪 Enhanced Wizard Reliability Testing"
puts "  Strategy: Complete flows, robust error handling"
puts "========================================="

set tests_passed 0

if {[test_wizard_detected_template_flow]} {
    incr tests_passed
}

if {[test_wizard_manual_template_flow]} {
    incr tests_passed
}

if {[test_wizard_interruption_handling]} {
    incr tests_passed
}

if {[test_wizard_existing_config_handling]} {
    incr tests_passed
}

if {[test_wizard_help]} {
    incr tests_passed
}

puts "\n========================================="
puts "📊 Wizard Test Results: $tests_passed/5 passed"
puts "========================================="

if {$tests_passed == 5} {
    puts "🎉 All wizard tests passed!"
    exit 0
} else {
    puts "⚠️  Some wizard tests need attention"
    exit 1
}
