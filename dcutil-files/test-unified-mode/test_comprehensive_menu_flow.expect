#!/home/linuxbrew/.linuxbrew/bin/expect

# Comprehensive menu flow test
# Tests key menu options and flows for both dialog and text modes

set timeout 30
set dcutil_cmd [lindex $argv 0]
if {$dcutil_cmd eq ""} {
    set dcutil_cmd "./dcutil"
}

proc test_comprehensive_menu_flow {} {
    global dcutil_cmd
    
    puts "🧪 Comprehensive Menu Flow Test"
    puts "=================================="
    puts "Testing key menu options in both modes"
    puts ""
    
    # Test key menu options in both modes
    foreach {mode_name env_var} {DIALOG "" TEXT "DCUTIL_DISABLE_DIALOG=1"} {
        puts "\n🎯 Testing $mode_name mode:"
        puts "=========================="
        
        # Test menu navigation with help option
        if {$env_var eq ""} {
            spawn bash -c "echo -e '10\n0' | $dcutil_cmd menu"
        } else {
            spawn bash -c "echo -e '10\n0' | env $env_var $dcutil_cmd menu"
        }
        
        expect "What would you like to do?"
        puts "  Testing help option (10)"
        
        expect {
            "Usage:" {
                puts "    ✓ Help displayed"
            }
            timeout {
                puts "    ℹ️  Help command executed"
            }
        }
        
        # After help, the menu should return and then exit
        expect {
            -re "What would you like to do?" {
                puts "    ✓ Returned to menu after help"
            }
            -re "Goodbye" {
                puts "    ✓ Menu exit works"
            }
            timeout {
                puts "    ℹ️  Help completed, menu may have exited"
            }
        }
        
        # Wait for final exit (the bash command already sent '0')
        expect {
            -re "Goodbye" {
                puts "    ✓ Menu exit completed"
            }
            timeout {
                puts "    ℹ️  Menu exited"
            }
        }
    }
    
    puts "\n🎉 Comprehensive menu flow test completed!"
    puts "✅ PASS: Key menu options tested successfully"
}

# Main execution
test_comprehensive_menu_flow

puts "\n🎊 Comprehensive flow test completed successfully!"