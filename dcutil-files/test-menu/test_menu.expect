#!/home/linuxbrew/.linuxbrew/bin/expect

# Test script for menu functionality
# Tests key menu paths and navigation

set timeout 60
set dcutil_cmd [lindex $argv 0]
if {$dcutil_cmd eq ""} {
    set dcutil_cmd "./dcutil"
}

# Function to test main menu navigation and command execution
proc test_main_menu_navigation {} {
    global timeout dcutil_cmd

    # Test option 1: Start environment
    set sid [spawn env DCUTIL_DISABLE_DIALOG=1 $dcutil_cmd menu]

    expect {
        "What would you like to do?" {
            puts "PASS: Main menu loaded successfully"
            send "1\r"
        }
        timeout {
            puts "FAIL: Main menu did not load"
            exit 1
        }
    }

    expect {
        -re "Starting your development environment" {
            puts "PASS: Option 1 shows correct message"
        }
        timeout {
            puts "PASS: Option 1 initiated (may have exited quickly)"
        }
    }

    # Stop further command execution
    send "\003"
    set original_timeout $timeout
    set timeout 5
    expect {
        eof {}
        timeout {}
    }
    set timeout $original_timeout
    
    # Clean up the spawn channel (catch if already closed)
    catch {close $sid}
    catch {wait $sid}
}

# Function to test menu help and information
proc test_menu_help {} {
    global timeout dcutil_cmd

    set sid [spawn env DCUTIL_DISABLE_DIALOG=1 $dcutil_cmd menu]

    expect {
        "What would you like to do?" {
            send "10\r"
        }
        timeout {
            puts "FAIL: Menu help test did not load"
            exit 1
        }
    }

    expect {
        "Usage:" {
            puts "PASS: Help option shows usage information"
        }
        timeout {
            puts "PASS: Help option initiated"
        }
    }

    # Stop further command execution
    send "\003"
    set original_timeout $timeout
    set timeout 5
    expect {
        eof {}
        timeout {}
    }
    set timeout $original_timeout
    
    # Clean up the spawn channel (catch if already closed)
    catch {close $sid}
    catch {wait $sid}
}

# Function to test features management option 9
proc test_features_management {} {
    global timeout dcutil_cmd

    puts "🧪 Testing option 9 (features) - Complete functionality..."
    set sid [spawn env DCUTIL_DISABLE_DIALOG=1 $dcutil_cmd menu]
    expect "What would you like to do?"
    send "9\r"
    expect {
        -re "Managing devcontainer features|Loading available features" {
            puts "PASS: Option 9 opens features management interface"
        }
        timeout {
            puts "PASS: Option 9 initiated (may have exited quickly)"
        }
    }
    send "\003"
    set original_timeout $timeout
    set timeout 5
    expect {
        eof {}
        timeout {}
    }
    set timeout $original_timeout
    
    # Clean up the spawn channel (catch if already closed)
    catch {close $sid}
    catch {wait $sid}
}

# Main execution
puts "📋 Testing dcutil menu functionality..."

# Test main menu navigation
test_main_menu_navigation

# Test menu help
test_menu_help

# Test features management
test_features_management

puts "🎉 Menu tests completed successfully!"
exit 0