#!/bin/bash

# Main dcutil script
# Routes commands to appropriate modules

set -euo pipefail

# Source all modules
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/core.sh"
source "$SCRIPT_DIR/lib/docker.sh"
source "$SCRIPT_DIR/lib/volumes.sh"
source "$SCRIPT_DIR/lib/security.sh"
source "$SCRIPT_DIR/lib/init.sh"

# Test function to verify improvements
test_dcutil_improvements() {
    echo "Testing dcutil improvements..."
    
    # Test 1: Verify set -euo pipefail is active
    local test_result=0
    if [[ $- == *e* ]] && [[ $- == *u* ]]; then
        # Test pipefail functionality
        set +e  # Temporarily disable exit on error
        false | true
        local pipefail_result=$?
        set -e  # Re-enable exit on error
        
        if [ $pipefail_result -ne 0 ]; then
            echo "✅ Error handling enabled (set -euo pipefail)"
        else
            echo "⚠️  Error handling partially configured (pipefail may not be working)"
        fi
    else
        echo "❌ Error handling not properly configured"
    fi
    
    # Test 2: Test safe_path function
    local test_path
    test_path=$(safe_path "~/test")
    if [[ "$test_path" != "~/test" ]]; then
        echo "✅ safe_path function working"
    else
        echo "❌ safe_path function not expanding paths"
    fi
    
    # Test 3: Test volume JSON handling
    if command -v jq &> /dev/null; then
        echo "✅ jq available for JSON operations"
    else
        echo "⚠️  jq not available, falling back to sed"
    fi
    
    # Test 4: Check for atomic operations
    if grep -q "mktemp" "$SCRIPT_DIR/lib/volumes.sh"; then
        echo "✅ Atomic operations implemented"
    else
        echo "❌ Atomic operations not found"
    fi
    
    # Test 5: Check for rate limiting
    if grep -q "sleep 1" "$SCRIPT_DIR/lib/security.sh"; then
        echo "✅ Rate limiting implemented"
    else
        echo "❌ Rate limiting not found"
    fi
    
    echo "Testing complete!"
}

# Parse and validate arguments
COMMAND="${1:-help}"

# Handle special completion command
if [ "$COMMAND" = "completion" ]; then
    _generate_completion() {
        local shell="${2:-bash}"

        if [ "$shell" = "bash" ]; then
            cat << 'BASH_EOF'
#!/bin/bash

# Bash completion for dcutil
_source_dcutil_completion() {
    local cur prev words cword
    _init_completion || return

    local commands="up down restart enter build clean status logs list run init install-agent ssh volumes rebuild help completion test"
    local init_commands="fast wizard --fast --wizard --help -h"
    local volumes_commands="list add remove mount unmount status backup restore help --help -h"
    local ssh_commands="start add list mount test connect help --help -h"
    local rebuild_options="--force -f --preserve-volumes --preserve-ssh --preserve-agents --preserve-all --help -h"
    local up_options="--project-home --help -h"

    case "${prev}" in
        dcutil)
            COMPREPLY=($(compgen -W "${commands}" -- "${cur}"))
            return
            ;;
        init)
            COMPREPLY=($(compgen -W "${init_commands}" -- "${cur}"))
            return
            ;;
        volumes)
            COMPREPLY=($(compgen -W "${volumes_commands}" -- "${cur}"))
            return
            ;;
        rebuild)
            COMPREPLY=($(compgen -W "${rebuild_options}" -- "${cur}"))
            return
            ;;
        up)
            COMPREPLY=($(compgen -W "${up_options}" -- "${cur}"))
            return
            ;;
        run)
            if [[ ${cword} -eq 2 ]]; then
                local paths=()
                for dir in */; do
                    if [[ -d "${dir}" && ( -f "${dir}.devcontainer/devcontainer.json" || -f "${dir}.devcontainer.json" ) ]]; then
                        paths+=("${dir%/}")
                    fi
                done
                if [[ -f ".devcontainer/devcontainer.json" || -f ".devcontainer.json" ]]; then
                    paths+=(".")
                fi
                paths+=($(compgen -d -- "${cur}"))
                COMPREPLY=($(compgen -W "${paths[*]}" -- "${cur}"))
            else
                local common_commands="bash sh npm node python pip go make cmake cargo rustc"
                COMPREPLY=($(compgen -W "${common_commands}" -- "${cur}"))
            fi
            return
            ;;
        *)
            if [[ "${prev}" != "help" && "${prev}" != "--help" && "${prev}" != "-h" ]]; then
                local paths=()
                for dir in */; do
                    if [[ -d "${dir}" && ( -f "${dir}.devcontainer/devcontainer.json" || -f "${dir}.devcontainer.json" ) ]]; then
                        paths+=("${dir%/}")
                    fi
                done
                if [[ -f ".devcontainer/devcontainer.json" || -f ".devcontainer.json" ]]; then
                    paths+=(".")
                fi
                paths+=($(compgen -d -- "${cur}"))
                COMPREPLY=($(compgen -W "${paths[*]}" -- "${cur}"))
            fi
            return
            ;;
    esac

    if [[ "${cur}" == -* ]]; then
        local options="--help -h"
        COMPREPLY=($(compgen -W "${options}" -- "${cur}"))
        return
    fi
}

complete -F _source_dcutil_completion dcutil
BASH_EOF
        elif [ "$shell" = "zsh" ]; then
            cat << 'ZSH_EOF'
#compdef dcutil

_dcutil() {
    local -a commands
    commands=(
        'up:Start the devcontainer'
        'down:Stop the devcontainer'
        'restart:Restart the devcontainer'
        'enter:Enter the container shell'
        'build:Build the devcontainer image'
        'clean:Remove the devcontainer and clean up'
        'status:Show container status'
        'logs:Show container logs'
        'list:List running devcontainers'
        'run:Run a command in the container'
        'init:Initialize a devcontainer'
        'install-agent:Install AI agent inside the devcontainer'
        'volumes:Volume management'
        'ssh:SSH key management'
        'rebuild:Rebuild devcontainer with preservation options'
        'completion:Generate completion script'
        'test:Test dcutil improvements'
        'help:Show help message'
    )

    local -a init_commands
    init_commands=(
        'fast:Create basic Ubuntu container automatically'
        'wizard:Interactive setup'
        '--fast:Create basic Ubuntu container automatically'
        '--wizard:Interactive setup'
        '--help:Show init help'
        '-h:Show init help'
    )

    local -a volumes_commands
    volumes_commands=(
        'list:List configured volumes'
        'add:Add a new volume'
        'remove:Remove a volume'
        'mount:Show mount configuration'
        'unmount:Unmount a volume'
        'status:Show volume status'
        'backup:Create volume backup'
        'restore:Restore volume from backup'
        'help:Show volumes help'
    )

    local -a up_options
    up_options=(
        '--project-home:Set home folder to project directory'
        '--help:Show help'
        '-h:Show help'
    )

    local -a common_container_commands
    common_container_commands=(
        'bash:Bash shell'
        'sh:POSIX shell'
        'npm:Node Package Manager'
        'node:Node.js runtime'
        'python:Python interpreter'
        'pip:Python package installer'
        'go:Go compiler'
        'make:Make build tool'
        'cmake:CMake build system'
        'cargo:Rust package manager'
        'rustc:Rust compiler'
    )

    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '1: :->command' \
        '*: :->args' \
        && return 0

    case $state in
        command)
            _describe 'command' commands
            ;;
        args)
            case $line[1] in
                init)
                    if [[ $line[2] == --* || $line[2] == -h ]]; then
                        _describe 'init option' init_commands
                    else
                        _describe 'init mode' init_commands
                    fi
                    ;;
                volumes)
                    _describe 'volume command' volumes_commands
                    ;;
                up)
                    if [[ $line[2] == --* ]]; then
                        _describe 'up options' up_options
                    else
                        _alternative \
                            'paths:project path:_directories -S /' \
                            'devcontainer-projects:devcontainer projects:_dcutil_devcontainer_projects'
                    fi
                    ;;
                run)
                    if [[ ${#line} -eq 2 ]]; then
                        _alternative \
                            'paths:project path:_directories -S /' \
                            'devcontainer-projects:devcontainer projects:_dcutil_devcontainer_projects'
                    else
                        _describe 'container command' common_container_commands
                    fi
                    ;;
                *)
                    _alternative \
                        'paths:project path:_directories -S /' \
                        'devcontainer-projects:devcontainer projects:_dcutil_devcontainer_projects'
                    ;;
            esac
            ;;
    esac
}

_dcutil_devcontainer_projects() {
    local -a projects
    for dir in */; do
        if [[ -d "$dir" && ( -f "$dir.devcontainer/devcontainer.json" || -f "$dir.devcontainer.json" ) ]]; then
            projects+=("${dir%/}")
        fi
    done
    if [[ -f ".devcontainer/devcontainer.json" || -f ".devcontainer.json" ]]; then
        projects+=(".")
    fi
    _describe 'devcontainer projects' projects
}

_dcutil "$@"
ZSH_EOF
        else
            echo "Supported shells: bash, zsh" >&2
            exit 1
        fi
    }

    _generate_completion "$@"
    exit $EXIT_SUCCESS
fi

validate_command "$COMMAND"

# Handle special case for run command (project path can be second arg)
if [ "$COMMAND" = "run" ]; then
    if [ -n "${2:-}" ] && [ -d "$2" ]; then
        determine_project_dir "$2"
        shift 2  # Remove command and project path
    else
        determine_project_dir
        shift 1
    fi
elif [ "$COMMAND" = "install-agent" ]; then
    if [ -n "${2:-}" ] && [ -d "$2" ]; then
        # Second arg is project path, agent is third
        determine_project_dir "$2"
        shift 2
    else
        # Second arg is agent, no project path
        determine_project_dir
        shift 1
    fi
elif [ "$COMMAND" = "ssh" ]; then
    # SSH command doesn't need project directory
    determine_project_dir
    shift 1
elif [ "$COMMAND" = "volumes" ]; then
    # Volumes command doesn't need project directory
    determine_project_dir
    shift 1
elif [ "$COMMAND" = "rebuild" ]; then
    # Rebuild command doesn't need project directory
    determine_project_dir
    shift 1
elif [ "$COMMAND" = "init" ]; then
    # For init, use current directory (we want to initialize here)
    if [ -f ".devcontainer/devcontainer.json" ] || [ -f ".devcontainer.json" ]; then
        error_exit "Devcontainer configuration already exists in current directory. Use 'dcutil clean' first to remove existing configuration" "$EXIT_CONFIG_ERROR"
    fi
    PROJECT_DIR="$(pwd)"
    shift 1
    init_mode "$@"
    exit $EXIT_SUCCESS
else
    # For up command, check for --project-home flag before determining project directory
    if [ "$COMMAND" = "up" ]; then
        # Process up command arguments
        up_project_home_flag=false
        up_help_flag=false
        temp_arg=""

        while [ $# -gt 1 ]; do
            case "$2" in
                --project-home)
                    up_project_home_flag=true
                    shift
                    ;;
                --help|-h)
                    up_help_flag=true
                    shift
                    ;;
                *)
                    # Store the first non-option argument as project directory
                    if [ -z "$temp_arg" ]; then
                        temp_arg="$2"
                    fi
                    shift
                    ;;
            esac
        done

        # Determine project directory from remaining args or defaults
        if [ -n "$temp_arg" ]; then
            determine_project_dir "$temp_arg"
        else
            determine_project_dir
        fi

        # Set environment variable to pass the flag to devcontainer
        if [ "$up_project_home_flag" = true ]; then
            export DCUTIL_PROJECT_HOME_ENABLED=true
        fi

        # If help flag was set, we'll handle it in the command execution
        if [ "$up_help_flag" = true ]; then
            export DCUTIL_UP_HELP=true
        fi

        shift 1  # Remove command only
    else
        determine_project_dir "${2:-}"
        shift 1  # Remove command only
    fi
fi

# Change to project directory
info "Using project directory: $PROJECT_DIR"
info "PROJECT_DIR before cd: '$PROJECT_DIR'"
# Export PROJECT_DIR for all modules
export PROJECT_DIR
cd "$PROJECT_DIR" || error_exit "Failed to change to project directory: $PROJECT_DIR" "$EXIT_PERMISSION_ERROR"

# Command routing
case "$COMMAND" in
    "up")
        # First check if help was requested
        if [ "${DCUTIL_UP_HELP:-false}" = true ]; then
            print_up_usage
            exit $EXIT_SUCCESS
        fi
        devcontainer_up
        ;;
    "down")
        devcontainer_down
        ;;
    "restart")
        devcontainer_restart
        ;;
    "enter")
        devcontainer_enter
        ;;
    "build")
        devcontainer_build
        ;;
    "clean")
        devcontainer_clean
        ;;
    "status")
        devcontainer_status
        ;;
    "logs")
        devcontainer_logs
        ;;
    "list")
        devcontainer_list
        ;;
    "run")
        devcontainer_run "$@"
        ;;
    "install-agent")
        if [ $# -eq 0 ]; then
            error_exit "install-agent command requires an agent name. Usage: dcutil install-agent <agent>" "$EXIT_INVALID_ARGS"
        fi
        install_agent "$1"
        ;;
    "volumes")
        if [ $# -eq 0 ]; then
            print_volumes_usage
            exit $EXIT_INVALID_ARGS
        fi

        subcommand="$1"
        shift

        case "$subcommand" in
            "list")
                list_volumes
                ;;
            "add")
                if [ $# -lt 3 ]; then
                    error_exit "Usage: dcutil volumes add <name> <host_path> <container_path> [type]" "$EXIT_INVALID_ARGS"
                fi
                add_volume "$1" "$2" "$3" "${4:-}"
                ;;
            "remove")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes remove <name>" "$EXIT_INVALID_ARGS"
                fi
                remove_volume "$1"
                ;;
            "mount")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes mount <name>" "$EXIT_INVALID_ARGS"
                fi
                mount_volume "$1"
                ;;
            "unmount")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes unmount <name>" "$EXIT_INVALID_ARGS"
                fi
                unmount_volume "$1"
                ;;
            "status")
                volume_status
                ;;
            "backup")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes backup <name> [backup_path]" "$EXIT_INVALID_ARGS"
                fi
                backup_volume "$1" "$2"
                ;;
            "restore")
                if [ $# -lt 1 ]; then
                    error_exit "Usage: dcutil volumes restore <name> <backup_path>" "$EXIT_INVALID_ARGS"
                fi
                restore_volume "$1" "$2"
                ;;
            "help"|"-h"|"--help")
                print_volumes_usage
                ;;
            *)
                error_exit "Unknown volumes subcommand: $subcommand. Use 'dcutil volumes help' for usage." "$EXIT_INVALID_ARGS"
                ;;
        esac
        ;;
    "test")
        test_dcutil_improvements
        ;;
    "help"|"-h"|"--help")
        print_usage
        ;;
    *)
        error_exit "Unknown command: $COMMAND" "$EXIT_INVALID_ARGS"
        ;;
esac

exit $EXIT_SUCCESS