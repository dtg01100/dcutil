#!/usr/bin/env bash

# Main dcutil script
# Routes commands to appropriate modules

VERSION="v1.5.7"

set -euo pipefail

# Source other dcutil modules for enhanced functionality
# Resolve symlinks properly for different installation methods
if [ -L "${BASH_SOURCE[0]}" ]; then
    # Symlinked (Homebrew) - resolve to actual script location
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
else
    # Direct execution
    SCRIPT_PATH="${BASH_SOURCE[0]}"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
if [ -d "$SCRIPT_DIR/lib" ]; then
    LIB_DIR="$SCRIPT_DIR/lib"
elif [ -d "$SCRIPT_DIR/../lib" ]; then
    LIB_DIR="$SCRIPT_DIR/../lib"
elif [ -L "$SCRIPT_DIR/core.sh" ]; then
    # Homebrew installation - libraries are symlinked in bin directory
    LIB_DIR="$SCRIPT_DIR/../libexec"
else
    echo "Error: Could not find dcutil library files" >&2
    exit 1
fi

# Source core functionality first
source "$LIB_DIR/core.sh"

# Guardrail: Check for root user
check_root_user

# Always use official devcontainer CLI as primary engine with dcutil enhancements
info "Using official devcontainer CLI with dcutil enhancements"
source "$LIB_DIR/api_official_cli.sh"

source "$LIB_DIR/docker.sh"
if [ -f "$LIB_DIR/volumes.sh" ]; then
    source "$LIB_DIR/volumes.sh"
fi
if [ -f "$LIB_DIR/security.sh" ]; then
    source "$LIB_DIR/security.sh"
fi
if [ -f "$LIB_DIR/init.sh" ]; then
    source "$LIB_DIR/init.sh"
fi

# Load optional modules for enhanced functionality
if [ -f "$LIB_DIR/features.sh" ]; then
    source "$LIB_DIR/features.sh"
fi

if [ -f "$LIB_DIR/lockfile.sh" ]; then
    source "$LIB_DIR/lockfile.sh"
fi

if [ -f "$LIB_DIR/lifecycle.sh" ]; then
    source "$LIB_DIR/lifecycle.sh"
fi
# environment module is optional
if [ -f "$LIB_DIR/environment.sh" ]; then
    source "$LIB_DIR/environment.sh"
fi
# userprobe module is optional
if [ -f "$LIB_DIR/userprobe.sh" ]; then
    source "$LIB_DIR/userprobe.sh"
fi
# hostrequirements module is optional
if [ -f "$LIB_DIR/hostrequirements.sh" ]; then
    source "$LIB_DIR/hostrequirements.sh"
fi
# shutdown module is optional
if [ -f "$LIB_DIR/shutdown.sh" ]; then
    source "$LIB_DIR/shutdown.sh"
fi
# schema validation module is optional
if [ -f "$LIB_DIR/schema-validation.sh" ]; then
    source "$LIB_DIR/schema-validation.sh"
fi
# podman backend module is optional
if [ -f "$LIB_DIR/podman.sh" ]; then
    source "$LIB_DIR/podman.sh"
fi
# monitoring module is optional
if [ -f "$LIB_DIR/monitoring.sh" ]; then
    source "$LIB_DIR/monitoring.sh"
fi
# UX enhancements module is optional
if [ -f "$LIB_DIR/ux.sh" ]; then
    source "$LIB_DIR/ux.sh"
fi

# Initialize backend system
if command -v init_podman_backend >/dev/null 2>&1; then
    init_podman_backend
fi

# Test function to verify improvements
test_dcutil_improvements() {
    echo "Testing dcutil improvements..."
    
    # Test 1: Verify set -euo pipefail is active

    if [[ $- == *e* ]] && [[ $- == *u* ]]; then
        # Test pipefail functionality
        set +e  # Temporarily disable exit on error
        false | true
        local pipefail_result=$?
        set -e  # Re-enable exit on error
        
        if [ $pipefail_result -ne 0 ]; then
            echo "✅ Error handling enabled (set -euo pipefail)"
        else
            echo "⚠️  Error handling partially configured (pipefail may not be working)"
        fi
    else
        echo "❌ Error handling not properly configured"
    fi
    
    # Test 2: Test safe_path function
    local test_path
    test_path=$(safe_path "$HOME/test")
    if [[ "$test_path" != "$HOME/test" ]]; then
        echo "✅ safe_path function working"
    else
        echo "❌ safe_path function not expanding paths"
    fi
    
    # Test 3: Test volume JSON handling
    if command -v jq &> /dev/null; then
        echo "✅ jq available for JSON operations"
    else
        echo "⚠️  jq not available, falling back to sed"
    fi
    
    # Test 4: Check for atomic operations
    if grep -q "mktemp" "$LIB_DIR/volumes.sh"; then
        echo "✅ Atomic operations implemented"
    else
        echo "❌ Atomic operations not found"
    fi
    
    # Test 5: Check for rate limiting
    if grep -q "sleep.*seconds" "$LIB_DIR/security.sh"; then
        echo "✅ Rate limiting implemented"
    else
        echo "❌ Rate limiting not found"
    fi
    
    echo "Testing complete!"
}

# Show first-time welcome if this is the first run (skip in non-interactive/CI)
if [ -t 0 ] && [ -z "${CI:-}" ] && [ -z "${GITHUB_ACTIONS:-}" ]; then
    if command -v show_first_time_welcome >/dev/null 2>&1; then
        if show_first_time_welcome; then
            : # Continue normally
        else
            # User chose interactive menu from welcome
            COMMAND="menu"
        fi
    fi
fi

# Parse and validate arguments  
COMMAND="${1:-menu}"  # Default to menu instead of help for better UX
# Allow a special verify-dialog command for debugging dialog UI without running full wizard
if [ "${1:-}" = "verify-dialog" ]; then
    export PROJECT_DIR
    if command -v lib/init.sh >/dev/null 2>&1; then
        echo "Running dialog verification..."
    fi
fi

# Handle special completion command
if [ "$COMMAND" = "completion" ]; then
    _generate_completion() {
        local shell="${2:-bash}"

        if [ "$shell" = "bash" ]; then
            cat << 'BASH_EOF'
#!/bin/bash

# Bash completion for dcutil
_dcutil() {
    local cur prev words cword
    _init_completion || return

    local commands="up down restart enter build clean status stats logs list run init install-agent check ssh volumes compose features advanced integration merging userprobe hostrequirements shutdown rebuild schema podman lockfile version help completion test menu"
    local init_commands="fast wizard --fast --wizard --help -h"
    local volumes_commands="list add remove mount unmount status backup restore help --help -h"
    local ssh_commands="start add list mount test connect help --help -h"
    local compose_commands="up down restart status list exec logs build clean help --help -h"
    local stats_commands="show watch detailed top help --help -h"
    local build_commands="info validate clean help --help -h"
    local rebuild_options="--force -f --preserve-volumes --preserve-ssh --preserve-agents --preserve-all --help -h"
    local up_options="--project-home --help -h"

    case "${prev}" in
        dcutil)
            COMPREPLY=($(compgen -W "${commands}" -- "${cur}"))
            return
            ;;
        init)
            COMPREPLY=($(compgen -W "${init_commands}" -- "${cur}"))
            return
            ;;
        volumes)
            COMPREPLY=($(compgen -W "${volumes_commands}" -- "${cur}"))
            return
            ;;
        compose)
            COMPREPLY=($(compgen -W "${compose_commands}" -- "${cur}"))
            return
            ;;
        stats)
            COMPREPLY=($(compgen -W "${stats_commands}" -- "${cur}"))
            return
            ;;
        build)
            COMPREPLY=($(compgen -W "${build_commands}" -- "${cur}"))
            return
            ;;
        rebuild)
            COMPREPLY=($(compgen -W "${rebuild_options}" -- "${cur}"))
            return
            ;;
        up)
            COMPREPLY=($(compgen -W "${up_options}" -- "${cur}"))
            return
            ;;
        run)
            if [[ ${cword} -eq 2 ]]; then
                local paths=()
                for dir in */; do
                    if [[ -d "${dir}" && ( -f "${dir}.devcontainer/devcontainer.json" || -f "${dir}.devcontainer.json" ) ]]; then
                        paths+=("${dir%/}")
                    fi
                done
                if [[ -f ".devcontainer/devcontainer.json" || -f ".devcontainer.json" ]]; then
                    paths+=(".")
                fi
                paths+=($(compgen -d -- "${cur}"))
                COMPREPLY=($(compgen -W "${paths[*]}" -- "${cur}"))
            else
                local common_commands="bash sh npm node python pip go make cmake cargo rustc"
                COMPREPLY=($(compgen -W "${common_commands}" -- "${cur}"))
            fi
            return
            ;;
        *)
            if [[ "${prev}" != "help" && "${prev}" != "--help" && "${prev}" != "-h" ]]; then
                local paths=()
                for dir in */; do
                    if [[ -d "${dir}" && ( -f "${dir}.devcontainer/devcontainer.json" || -f "${dir}.devcontainer.json" ) ]]; then
                        paths+=("${dir%/}")
                    fi
                done
                if [[ -f ".devcontainer/devcontainer.json" || -f ".devcontainer.json" ]]; then
                    paths+=(".")
                fi
                paths+=($(compgen -d -- "${cur}"))
                COMPREPLY=($(compgen -W "${paths[*]}" -- "${cur}"))
            fi
            return
            ;;
    esac

    if [[ "${cur}" == -* ]]; then
        local options="--help -h"
        COMPREPLY=($(compgen -W "${options}" -- "${cur}"))
        return
    fi
}

complete -F _dcutil dcutil
BASH_EOF
        elif [ "$shell" = "zsh" ]; then
            cat << 'ZSH_EOF'
#compdef dcutil

_dcutil() {
local -a commands
    commands=(
        'up:Start the devcontainer'
        'down:Stop the devcontainer'
        'restart:Restart the devcontainer'
        'enter:Enter the container shell'
        'build:Build the devcontainer image'
