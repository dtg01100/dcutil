# Command routing
case "$COMMAND" in
    "up")
        # First check if help was requested
        if [ "${DCUTIL_UP_HELP:-false}" = true ]; then
            print_up_usage
            exit $EXIT_SUCCESS
        fi

        enhanced_dcutil_command "up" "$@"
        ;;
    "down")
        enhanced_dcutil_command "down" "$@"
        ;;

    "features")
        # Optional features command
        if [ -z "${1:-}" ]; then
            print_usage
            exit $EXIT_INVALID_ARGS
        fi
        features_cli "$@"
        exit $EXIT_SUCCESS
        ;;
    "restart")
        devcontainer_restart
        ;;
    "enter")
        devcontainer_enter
        ;;
    "build")
        enhanced_dcutil_command "build" "$@"
        ;;
    "status")
        devcontainer_status
        ;;
    "logs")
        devcontainer_logs
        ;;
     "list")
         devcontainer_list
         ;;
     "run")
         enhanced_dcutil_command "run" "$@"
         ;;
     "check")
         devcontainer_check
         ;;
     "install-agent")
        if [ $# -eq 0 ]; then
            error_exit "install-agent command requires an agent name. Usage: dcutil install-agent <agent>" "$EXIT_INVALID_ARGS"
        fi
        install_agent "$1"
        ;;
    "volumes")
        if [ $# -eq 0 ]; then
            print_volumes_usage
            exit $EXIT_INVALID_ARGS
        fi

        subcommand="$1"
        shift

        case "$subcommand" in
            "list")
                # Check if a project path was provided
                if [ -n "${1:-}" ] && [ -d "$1" ]; then
                    PROJECT_DIR="$1"
                    initialize_devcontainer_config
                    shift  # Remove the project path from arguments
                fi
                list_volumes
                ;;
            "add")
                if [ $# -lt 3 ]; then
                    error_exit "Usage: dcutil volumes add <name> <host_path> <container_path> [type] [project_path]" "$EXIT_INVALID_ARGS"
                fi
                # Check if last argument is a project path
                if [ $# -gt 3 ] && [ -d "${!#}" ]; then
                    PROJECT_DIR="${!#}"
                    initialize_devcontainer_config
                    # Remove the project path from arguments
                    set -- "${@:1:$#-1}"
                fi
                add_volume "$1" "$2" "$3" "${4:-}"
                ;;
            "remove")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes remove <name>" "$EXIT_INVALID_ARGS"
                fi
                remove_volume "$1"
                ;;
            "mount")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes mount <name>" "$EXIT_INVALID_ARGS"
                fi
                mount_volume "$1"
                ;;
            "unmount")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes unmount <name>" "$EXIT_INVALID_ARGS"
                fi
                unmount_volume "$1"
                ;;
            "status")
                volume_status
                ;;
            "backup")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil volumes backup <name> [backup_path]" "$EXIT_INVALID_ARGS"
                fi
                backup_volume "$1" "${2:-}"
                ;;
            "restore")
                if [ $# -lt 2 ]; then
                    error_exit "Usage: dcutil volumes restore <name> <backup_path>" "$EXIT_INVALID_ARGS"
                fi
                restore_volume "$1" "$2"
                ;;
            "help"|"-h"|"--help")
                print_volumes_usage
                ;;
            *)
                error_exit "Unknown volumes subcommand: $subcommand. Use 'dcutil volumes help' for usage." "$EXIT_INVALID_ARGS"
                ;;
        esac
        ;;
    "compose")
        if [ $# -eq 0 ]; then
            print_compose_usage
            exit $EXIT_INVALID_ARGS
        fi

        subcommand="$1"
        shift

        case "$subcommand" in
            "up")
                devcontainer_compose_up
                ;;
            "down")
                devcontainer_compose_down
                ;;
            "restart")
                devcontainer_compose_restart
                ;;
            "logs")
                devcontainer_compose_logs
                ;;
            "scale")
                # Scale services
                if [ $# -lt 2 ]; then
                    error_exit "Usage: dcutil compose scale <service> <replicas>" "$EXIT_INVALID_ARGS"
                fi
                if command -v docker_compose_scale >/dev/null 2>&1; then
                    docker_compose_scale "$1" "$2"
                else
                    error_exit "Compose scale not available. No compose configuration found." "$EXIT_CONFIG_ERROR"
                fi
                exit $EXIT_SUCCESS
                ;;
            "config")
                # Show compose configuration
                if command -v docker_compose_config >/dev/null 2>&1; then
                    docker_compose_config
                else
                    error_exit "Compose config not available. No compose configuration found." "$EXIT_CONFIG_ERROR"
                fi
                exit $EXIT_SUCCESS
                ;;
            "exec")
                if [ $# -eq 0 ]; then
                    error_exit "Usage: dcutil compose exec <command>" "$EXIT_INVALID_ARGS"
                fi
                devcontainer_compose_exec "$@"
                ;;
            "status")
                devcontainer_compose_status
                ;;
            "build")
                devcontainer_compose_build
                ;;
            "clean")
                devcontainer_compose_clean
                ;;
            "help"|"-h"|"--help")
                print_compose_usage
                ;;
            *)
                error_exit "Unknown compose subcommand: $subcommand. Use 'dcutil compose help' for usage." "$EXIT_INVALID_ARGS"
                ;;
        esac
        ;;
