            *)
                error_exit "Unknown lifecycle subcommand: ${1:-}. Use 'dcutil lifecycle help' for usage." "$EXIT_INVALID_ARGS"
                ;;
        esac

elif [ "$COMMAND" = "advanced" ]; then
    # Advanced features command doesn't need project directory
    determine_project_dir
    shift 1
    
    # Set up environment for advanced features modules
    export PROJECT_DIR
    cd "$PROJECT_DIR" || error_exit "Failed to change to project directory: $PROJECT_DIR" "$EXIT_PERMISSION_ERROR"
    
    # Check for advanced features subcommands
    case "${1:-}" in
        "info")
            # Show advanced features info
            if command -v show_advanced_features_info >/dev/null 2>&1; then
                show_advanced_features_info
            else
                error_exit "Advanced features info not available. No advanced features configuration found." "$EXIT_CONFIG_ERROR"
            fi
            exit $EXIT_SUCCESS
            ;;
        "validate")
            # Validate advanced features configuration
            if command -v validate_advanced_features_config >/dev/null 2>&1; then
                validate_advanced_features_config
            else
                error_exit "Advanced features validation not available. No advanced features configuration found." "$EXIT_CONFIG_ERROR"
            fi
            exit $EXIT_SUCCESS
            ;;
        "apply")
            # Apply advanced features
            if command -v apply_advanced_features >/dev/null 2>&1; then
                apply_advanced_features
            else
                error_exit "Advanced features application not available. No advanced features configuration found." "$EXIT_CONFIG_ERROR"
            fi
            exit $EXIT_SUCCESS
            ;;
        "help"|"-h"|"--help")
            cat << 'EOF'
Usage: dcutil advanced <command> [options]

Advanced devcontainer features for enhanced configuration:

Commands:
  info      Show advanced features configuration
  validate  Validate advanced features configuration
  apply     Apply advanced features to running container

Examples:
  dcutil advanced info
  dcutil advanced validate
  dcutil advanced apply

Supports updateRemoteUserUID, entrypoint override, overrideCommand,
forwardPorts, portsAttributes, and workspaceMount features.
EOF
            exit $EXIT_SUCCESS
            ;;
        "")
