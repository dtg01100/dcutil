  dcutil <command> --help

New to this? Just run:
  dcutil init                  # Guided setup wizard
EOF
}

# Handle help command before any other processing
if [ "$COMMAND" = "help" ] || [ "$COMMAND" = "-h" ] || [ "$COMMAND" = "--help" ]; then
    print_usage
    exit $EXIT_SUCCESS
fi

# Handle special case for run command (project path can be second arg)
if [ "$COMMAND" = "run" ]; then
    if [ -n "${2:-}" ] && [ -d "$2" ]; then
        determine_project_dir "$2"
        shift 2  # Remove command and project path
    else
        determine_project_dir
        shift 1
    fi
elif [ "$COMMAND" = "install-agent" ]; then
    if [ -n "${2:-}" ] && [ -d "$2" ]; then
        # Second arg is project path, agent is third
        determine_project_dir "$2"
        shift 2
    else
        # Second arg is agent, no project path
        determine_project_dir
        shift 1
    fi
elif [ "$COMMAND" = "ssh" ]; then
    # SSH command doesn't need project directory
    determine_project_dir
    shift 1
elif [ "$COMMAND" = "volumes" ]; then
    # Volumes command can take an optional project directory
    determine_project_dir
    shift 1
elif [ "$COMMAND" = "compose" ]; then
    # Compose command doesn't need project directory
    determine_project_dir
    shift 1
elif [ "$COMMAND" = "build" ]; then
    # Build command doesn't need project directory
    determine_project_dir
    shift 1
    
    # Set up environment for build modules
    export PROJECT_DIR
    cd "$PROJECT_DIR" || error_exit "Failed to change to project directory: $PROJECT_DIR" "$EXIT_PERMISSION_ERROR"
    
    # Check for build subcommands
    case "${1:-}" in
        "info")
            # Show build info
            if command -v show_build_info >/dev/null 2>&1; then
                show_build_info
            else
                error_exit "Build info not available. No build configuration found." "$EXIT_CONFIG_ERROR"
            fi
            exit $EXIT_SUCCESS
            ;;
        "validate")
            # Validate build configuration
            if command -v validate_build_config >/dev/null 2>&1; then
                if validate_build_config; then
                    success "Build configuration is valid"
                else
                    error_exit "Build configuration validation failed" "$EXIT_CONFIG_ERROR"
                fi
            else
                error_exit "Build validation not available. No build configuration found." "$EXIT_CONFIG_ERROR"
            fi
            exit $EXIT_SUCCESS
            ;;
        "clean")
            # Clean build artifacts
            if command -v clean_build_artifacts >/dev/null 2>&1; then
                clean_build_artifacts
            else
                error_exit "Build clean not available. No build configuration found." "$EXIT_CONFIG_ERROR"
            fi
            exit $EXIT_SUCCESS
            ;;
        "")
            # Standard build - fall through to normal processing
            ;;
        *)
            # Assume it's a project path or invalid
            ;;
    esac
    
    # Standard build command
    docker_build "$@"
    exit $EXIT_SUCCESS
elif [ "$COMMAND" = "stats" ]; then
    # Stats command for resource monitoring
    determine_project_dir
    shift 1
    
    # Set up environment
    export PROJECT_DIR
    cd "$PROJECT_DIR" || error_exit "Failed to change to project directory: $PROJECT_DIR" "$EXIT_PERMISSION_ERROR"
    
    # Handle stats command
    if command -v handle_stats_command >/dev/null 2>&1; then
        handle_stats_command "$PROJECT_DIR" "$@"
    else
        error_exit "Stats functionality not available. Monitoring module not loaded." "$EXIT_CONFIG_ERROR"
    fi
    exit $EXIT_SUCCESS
elif [ "$COMMAND" = "hostrequirements" ]; then
    # Host requirements command doesn't need project directory
    determine_project_dir
    shift 1
elif [ "$COMMAND" = "shutdown" ]; then
    # Shutdown action command doesn't need project directory
    determine_project_dir
    shift 1
    elif [ "$COMMAND" = "lifecycle" ]; then
        # Lifecycle command doesn't need project directory
        determine_project_dir
        shift 1

        # Set up environment for lifecycle modules
        export PROJECT_DIR
        cd "$PROJECT_DIR" || error_exit "Failed to change to project directory: $PROJECT_DIR" "$EXIT_PERMISSION_ERROR"

        # Check for lifecycle subcommands
        case "${1:-}" in
            "info"|"list")
