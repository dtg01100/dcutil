            if command -v show_advanced_features_info >/dev/null 2>&1; then
                show_advanced_features_info
            else
                error_exit "No advanced features configured or advanced features module not available." "$EXIT_CONFIG_ERROR"
            fi
            exit $EXIT_SUCCESS
            ;;
        *)
            error_exit "Unknown advanced subcommand: ${1:-}. Use 'dcutil advanced help' for usage." "$EXIT_INVALID_ARGS"
            ;;
    esac
elif [ "$COMMAND" = "integration" ]; then
    # Tool integration command doesn't need project directory
    determine_project_dir
    shift 1
    
    # Set up environment for integration modules
    export PROJECT_DIR
