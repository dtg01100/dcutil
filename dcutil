                    execute_shutdown_action "$container_name"
                else
                    error_exit "Shutdown action execution not available. No shutdownAction configuration found." "$EXIT_CONFIG_ERROR"
                fi
                ;;
            "show")
                if command -v show_shutdown_action_config >/dev/null 2>&1; then
                    show_shutdown_action_config
                else
                    error_exit "Shutdown action info not available. No shutdownAction configuration found." "$EXIT_CONFIG_ERROR"
                fi
                ;;
            "validate")
                if command -v validate_shutdown_action_config >/dev/null 2>&1; then
                    validate_shutdown_action_config
                else
                    error_exit "Shutdown action validation not available. No shutdownAction configuration found." "$EXIT_CONFIG_ERROR"
                fi
                ;;
            "help"|"-h"|"--help")
                print_shutdown_usage
                ;;
            *)
                error_exit "Unknown shutdown subcommand: $subcommand. Use 'dcutil shutdown help' for usage." "$EXIT_INVALID_ARGS"
                ;;
        esac
        ;;
"rebuild")
        # Rebuild command doesn't need project directory
        determine_project_dir ""
        
        # Set up environment for rebuild
        export PROJECT_DIR
        cd "$PROJECT_DIR" || error_exit "Failed to change to project directory: $PROJECT_DIR" "$EXIT_PERMISSION_ERROR"
        
# Execute rebuild with options (pass all remaining args)
        if command -v devcontainer_rebuild >/dev/null 2>&1; then
            devcontainer_rebuild "$@"
        else
            error_exit "Rebuild functionality not available." "$EXIT_CONFIG_ERROR"
        fi
        ;;
    "test")
        test_dcutil_improvements
        ;;
    "help"|"-h"|"--help")
        print_usage
        ;;
    *)
        error_exit "Unknown command: $COMMAND" "$EXIT_INVALID_ARGS"
        ;;
    esac

# Print main usage help
