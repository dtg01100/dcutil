#!/home/linuxbrew/.linuxbrew/bin/expect

# Text mode wizard testing
# Tests wizard functionality with DCUTIL_DISABLE_DIALOG=1

set timeout 120
set dcutil_cmd [lindex $argv 0]
if {$dcutil_cmd eq ""} {
    set dcutil_cmd "./dcutil"
}

# Test text mode wizard functionality
proc test_wizard_text_mode {} {
    global timeout dcutil_cmd
    
    puts "🧪 Testing dcutil wizard in TEXT mode..."
    
    # Prepare isolated environment
    set temp_home [exec mktemp -d /tmp/dcutil_wizard_text.XXXXXX]
    set project_dir "$temp_home/project"
    file mkdir "$project_dir/.devcontainer"
    
    # Create a devcontainer CLI stub that writes a config file when invoked with templates apply
    set temp_bin "$temp_home/bin"
    file mkdir $temp_bin
    set dev_stub "$temp_bin/devcontainer"
    set fh [open $dev_stub "w"]
    puts $fh "#!/bin/bash"
    puts $fh "case \"\$1 \$2\" in"
    puts $fh "  \"templates apply\")"
    puts $fh "    echo '{\"name\":\"test\",\"image\":\"ubuntu:22.04\"}' > .devcontainer/devcontainer.json"
    puts $fh "    echo 'Template applied successfully'"
    puts $fh "    exit 0"
    puts $fh "    ;;"
    puts $fh "esac"
    puts $fh "echo 'devcontainer CLI stub'"
    close $fh
    exec chmod +x $dev_stub
    
    # Run wizard in text mode
    spawn env HOME=$temp_home PATH="$temp_bin:/usr/local/bin:/usr/bin:/bin" CI=1 DCUTIL_DISABLE_DIALOG=1 $dcutil_cmd init wizard
    
    expect {
        "Devcontainer Initialization Wizard" {
            puts "✓ Wizard launched in text mode"
            
            # Wait for project type detection
            expect {
                "Automatically detected:" {
                    puts "✓ Project type detected in text mode"
                    
                    # Use detected template (option 1)
                    send "1\r"
                    
                    expect {
                        "Feature Selection" {
                            puts "✓ Feature selection reached in text mode"
                            
                            # Skip features (option 4)
                            send "4\r"
                            
                            expect {
                                "Advanced Configuration" {
                                    puts "✓ Advanced configuration reached in text mode"
                                    
                                    # Use defaults (press Enter)
                                    send "\r"
                                    
                                    expect {
                                        "Template applied successfully" {
                                            puts "✓ Template applied successfully in text mode"
                                        }
                                        "Error: The official devcontainer CLI is required" {
                                            puts "✓ Wizard correctly handles missing devcontainer CLI"
                                        }
                                        timeout {
                                            puts "✗ FAIL: Template application failed in text mode"
                                            exit 1
                                        }
                                    }
                                }
                                timeout {
                                    puts "✗ FAIL: Advanced configuration failed in text mode"
                                    exit 1
                                }
                            }
                        }
                        timeout {
                            puts "✗ FAIL: Feature selection failed in text mode"
                            exit 1
                        }
                    }
                }
                timeout {
                    puts "✗ FAIL: Project type detection failed in text mode"
                    exit 1
                }
            }
        }
        timeout {
            puts "✗ FAIL: Wizard failed to launch in text mode"
            exit 1
        }
    }
    
    puts "✅ Text mode wizard tests PASSED"
}

# Main execution
puts "========================================="
puts "🧪 Text Mode Wizard Testing"
puts "========================================="

test_wizard_text_mode

puts "🎉 Text mode wizard tests completed successfully!"