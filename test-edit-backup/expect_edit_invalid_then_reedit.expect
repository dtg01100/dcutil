#!/usr/bin/expect -f
set timeout 10
spawn ../dcutil edit
expect "Edit devcontainer.json with validation and optional re-edit"
# Simulate editor editing invalid JSON then valid later
# Use ed or sed? We'll just assert the prompt
expect "Invalid JSON syntax detected. Reopen editor? (Y/n):"
send "Y\r"
expect "Configuration updated"
puts "PASS"
exit 0
