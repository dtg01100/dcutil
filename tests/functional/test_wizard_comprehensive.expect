# Function to test wizard with features
proc test_wizard_with_features {} {
    global timeout dcutil_cmd
    
    spawn $dcutil_cmd init
    
    expect {
        "Welcome to dcutil!" {
            send "\r"
            expect {
                "Quick start guide" {
                    send "\r"
                    expect {
                        "What type of project is this?" {
                            send "1\r"  ;# Python
                            expect {
                                "Python version" {
                                    send "3.11\r"
                                    expect {
                                        "Additional features" {
                                            send "y\r"
                                            expect {
                                                "Select features to add" {
                                                    send "1\r"  ;# Select first feature
                                                    expect {
                                                        "Add another feature" {
                                                            send "n\r"
                                                            expect {
                                                                "Configuration complete" {
                                                                    puts "PASS: Wizard with features completed successfully"
                                                                    return 1
                                                                }
                                                                timeout {
                                                                    puts "FAIL: Wizard with features timed out"
                                                                    return 0
                                                                }
                                                            }
                                                        }
                                                        timeout {
                                                            send "n\r"
                                                        }
                                                    }
                                                }
                                                timeout {
                                                    send "n\r"
                                                }
                                            }
                                        }
                                        timeout {
                                            send "n\r"
                                        }
                                    }
                                }
                                timeout {
                                    send "3.11\r"
                                }
                            }
                        }
                        timeout {
                            send "\r"
                        }
                    }
                }
                timeout {
                    send "\r"
                }
            }
        }
        "Project already configured" {
            puts "INFO: Project already configured, skipping wizard with features"
            return 1
        }
        timeout {
            puts "FAIL: Wizard with features did not start"
            return 0
        }
    }
    
    expect eof
    return 0
}

# Function to test wizard error handling
proc test_wizard_error_handling {} {
    global timeout dcutil_cmd
    
    spawn $dcutil_cmd init
    
    expect {
        "Welcome to dcutil!" {
            send "\r"
            expect {
                "Quick start guide" {
                    send "\r"
                    expect {
                        "What type of project is this?" {
                            # Test invalid input
                            send "99\r"
                            expect {
                                "Invalid choice" {
                                    puts "PASS: Invalid input handled correctly"
                                    send "1\r"  ;# Valid choice
                                    expect {
                                        "Python version" {
                                            send "3.11\r"
                                            expect {
                                                "Configuration complete" {
                                                    puts "PASS: Error handling works"
                                                    return 1
                                                }
                                                timeout {
                                                    return 0
                                                }
                                            }
                                        }
                                        timeout {
                                            return 0
                                        }
                                    }
                                }
                                timeout {
                                    return 0
                                }
                            }
                        }
                        timeout {
                            return 0
                        }
                    }
                }
                timeout {
                    return 0
                }
            }
        }
        "Project already configured" {
            puts "INFO: Project already configured, skipping error handling test"
            return 1
        }
        timeout {
            puts "FAIL: Error handling test did not start"
            return 0
        }
    }
    
    expect eof
    return 0
}

# Main execution
puts "🧙 Testing dcutil wizard functionality..."

# Clean up any existing configuration
if {[file exists ".devcontainer"]} {
    exec rm -rf .devcontainer
}

# Test each wizard type
set tests_passed 0
set total_tests 6

if {[test_python_wizard]} {
    incr tests_passed
}

if {[test_nodejs_wizard]} {
    incr tests_passed
}

if {[test_go_wizard]} {
    incr tests_passed
}

if {[test_rust_wizard]} {
    incr tests_passed
}

if {[test_custom_image_wizard]} {
    incr tests_passed
}

if {[test_wizard_with_features]} {
    incr tests_passed
}

# Test error handling
if {[test_wizard_error_handling]} {
    incr tests_passed
    incr total_tests
}

puts "📊 Wizard test results: $tests_passed/$total_tests passed"

if {$tests_passed == $total_tests} {
    puts "🎉 All wizard tests passed!"
    exit 0
} else {
    puts "❌ Some wizard tests failed"
    exit 1
}