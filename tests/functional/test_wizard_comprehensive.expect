#!/home/linuxbrew/.linuxbrew/bin/expect

# Test script for wizard functionality
# Tests the init wizard with various project types and configurations

set timeout 120
set dcutil_cmd [lindex $argv 0]
if {$dcutil_cmd eq ""} {
    set dcutil_cmd "./dcutil"
}

# Function to test Python wizard
proc test_python_wizard {} {
    global timeout dcutil_cmd
    
    spawn $dcutil_cmd init
    
    expect {
        "Welcome to dcutil!" {
            send "\r"
            expect {
                "Quick start guide" {
                    send "\r"
                    expect {
                        "What type of project is this?" {
                            send "1\r"  ;# Python
                            expect {
                                "Python version" {
                                    send "3.11\r"
                                    expect {
                                        "Additional features" {
                                            send "n\r"
                                            expect {
                                                "Configuration complete" {
                                                    puts "PASS: Python wizard completed successfully"
                                                    return 1
                                                }
                                                timeout {
                                                    puts "FAIL: Python wizard timed out"
                                                    return 0
                                                }
                                            }
                                        }
                                        timeout {
                                            send "n\r"
                                        }
                                    }
                                }
                                timeout {
                                    send "3.11\r"
                                }
                            }
                        }
                        timeout {
                            send "\r"
                        }
                    }
                }
                timeout {
                    send "\r"
                }
            }
        }
        "Project already configured" {
            puts "INFO: Project already configured, skipping Python wizard"
            return 1
        }
        timeout {
            puts "FAIL: Python wizard did not start"
            return 0
        }
    }
    
    expect eof
    return 0
}

