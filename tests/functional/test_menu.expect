#!/home/linuxbrew/.linuxbrew/bin/expect

# Test script for menu functionality
# Tests all menu paths and navigation

set timeout 60
set dcutil_cmd [lindex $argv 0]
if {$dcutil_cmd eq ""} {
    set dcutil_cmd "./dcutil"
}

# Function to test main menu navigation
proc test_main_menu_navigation {} {
    global timeout dcutil_cmd
    
    spawn $dcutil_cmd menu
    
    expect {
        "What would you like to do?" {
            puts "PASS: Main menu loaded successfully"
            
            # Test option 1: Start environment
            send "1\r"
            
            expect {
                -re "Starting your development environment" {
                    puts "PASS: Option 1 - Start environment"
                    send "\r"
                    expect "What would you like to do?"
                }
                timeout {
                    send "\r"
                    expect "What would you like to do?"
                }
            }
            
            # Test option 2: Enter shell
            send "2\r"
            
            expect {
                -re "Opening a shell in your environment" {
                    puts "PASS: Option 2 - Enter shell"
                    expect {
                        "Your environment isn't running yet" {
                            send "n\r"  ;# Don't start
                            expect "What would you like to do?"
                        }
                        "bash" - "sh" {
                            send "exit\r"
                            expect "What would you like to do?"
                        }
                        timeout {
                            send "\r"
                            expect "What would you like to do?"
                        }
                    }
                }
                timeout {
                    send "\r"
                    expect "What would you like to do?"
                }
            }
            
            # Test option 3: Stop environment
            send "3\r"
            
            expect {
                -re "Stopping your environment" {
                    puts "PASS: Option 3 - Stop environment"
                    send "\r"
                    expect "What would you like to do?"
                }
                timeout {
                    send "\r"
                    expect "What would you like to do?"
                }
            }
            
            # Test option 4: Check status
            send "4\r"
            
            expect {
                -re "Checking environment status" {
                    puts "PASS: Option 4 - Check status"
                    send "\r"
                    expect "What would you like to do?"
                }
                timeout {
                    send "\r"
                    expect "What would you like to do?"
                }
            }
            
            # Test option 5: Show stats
            send "5\r"
            
            expect {
                -re "Showing resource usage" {
                    puts "PASS: Option 5 - Show stats"
                    send "\r"
                    expect "What would you like to do?"
                }
                timeout {
                    send "\r"
                    expect "What would you like to do?"
                }
            }
            
            # Test features menu
            send "9\r"
            expect "Managing devcontainer features..."
            
            # Test features options
            send "3\r"  ;# View features
            expect {
                "Enter search term to filter features" {
                    send "back\r"
                    expect "Press Enter to continue viewing"
                    send "\r"
                    
                    # Exit features menu
                    send "5\r"
                    expect {
                        "Exiting without saving changes" {
                            send "\r"
                        }
                        timeout {
                            send "\r"
                        }
                    }
                }
                timeout {
                    send "\r"
                }
            }
            
            # Test exit
            send "0\r"
            expect {
                "Goodbye" {
                    puts "PASS: Exit option works"
                }
                timeout {
                    send "\r"
                }
            }
        }
        timeout {
            puts "FAIL: Main menu did not load"
            exit 1
        }
    }
    
    expect eof
}

# Function to test features sub-navigation
proc test_features_subnavigation {} {
    global timeout dcutil_cmd
    
    spawn $dcutil_cmd menu
    
    expect {
        "What would you like to do?" {
            send "9\r"
            
            expect {
                "Managing devcontainer features..." {
                    puts "PASS: Features menu loaded"
                    
                    # Test option 1: Add feature
                    send "1\r"
                    
                    expect {
                        -re "Add a feature" {
                            puts "PASS: Features option 1 - Add feature"
                            expect {
                                "Enter search term" {
                                    send "back\r"
                                    expect "Managing devcontainer features..."
                                }
                                timeout {
                                    send "\r"
                                    expect "Managing devcontainer features..."
                                }
                            }
                        }
                        timeout {
                            send "\r"
                            expect "Managing devcontainer features..."
                        }
                    }
                    
                    # Test option 2: Remove feature
                    send "2\r"
                    
                    expect {
                        -re "Remove a feature" {
                            puts "PASS: Features option 2 - Remove feature"
                            expect {
                                "Currently configured features" {
                                    send "1\r"
                                    expect "Managing devcontainer features..."
                                }
                                "No features configured" {
                                    send "\r"
                                    expect "Managing devcontainer features..."
                                }
                                timeout {
                                    send "\r"
                                    expect "Managing devcontainer features..."
                                }
                            }
                        }
                        timeout {
                            send "\r"
                            expect "Managing devcontainer features..."
                        }
                    }
                    
                    # Test option 3: View features
                    send "3\r"
                    
                    expect {
                        -re "View available features" {
                            puts "PASS: Features option 3 - View features"
                            expect {
                                "Enter search term to filter features" {
                                    send "back\r"
                                    expect "Press Enter to continue viewing"
                                    send "\r"
                                    expect "Managing devcontainer features..."
                                }
                                timeout {
                                    send "back\r"
                                    expect "Press Enter to continue viewing"
                                    send "\r"
                                    expect "Managing devcontainer features..."
                                }
                            }
                        }
                        timeout {
                            send "\r"
                            expect "Managing devcontainer features..."
                        }
                    }
                    
                    # Test option 4: Save and exit
                    send "4\r"
                    
                    expect {
                        -re "Save changes and exit" {
                            puts "PASS: Features option 4 - Save and exit"
                            expect {
                                "Changes have been saved" {
                                    send "\r"
                                }
                                timeout {
                                    send "\r"
                                }
                            }
                        }
                        timeout {
                            send "\r"
                            expect "Managing devcontainer features..."
                        }
                    }
                    
                    # Test option 5: Exit without saving
                    send "5\r"
                    
                    expect {
                        -re "Exit without saving" {
                            puts "PASS: Features option 5 - Exit without saving"
                            expect {
                                "Exiting without saving changes" {
                                    send "\r"
                                }
                                timeout {
                                    send "\r"
                                }
                            }
                        }
                        timeout {
                            send "\r"
                            expect "Managing devcontainer features..."
                        }
                    }
                    
                    # Test invalid input in features menu
                    send "99\r"
                    expect {
                        "Invalid choice" {
                            puts "PASS: Invalid input in features menu handled correctly"
                        }
                        timeout {
                            send "\r"
                        }
                    }
                    
                    # Exit features menu
                    send "5\r"
                    expect {
                        "Exiting without saving changes" {
                            send "\r"
                        }
                        timeout {
                            send "\r"
                        }
                    }
                }
                timeout {
                    puts "FAIL: Did not reach features menu"
                    exit 1
                }
            }
        }
        timeout {
            puts "FAIL: Did not reach main menu"
            exit 1
        }
    }
    
    expect eof
}

# Function to test menu return functionality
proc test_menu_return_functionality {} {
    global timeout dcutil_cmd
    
    spawn $dcutil_cmd menu
    
    expect {
        "What would you like to do?" {
            # Navigate to features menu
            send "9\r"
            
            expect {
                "Managing devcontainer features..." {
                    # Perform some action
                    send "3\r"  ;# View features
                    
                    expect {
                        "Enter search term to filter features" {
                            send "back\r"
                            expect "Press Enter to continue viewing"
                            send "\r"
                            
                            # Should return to features menu
                            expect "Managing devcontainer features..."
                            
                            # Exit features menu
                            send "5\r"
                            expect {
                                "Exiting without saving changes" {
                                    send "\r"
                                }
                                timeout {
                                    send "\r"
                                }
                            }
                        }
                        timeout {
                            send "\r"
                            expect "Managing devcontainer features..."
                        }
                    }
                }
                timeout {
                    send "\r"
                    expect "What would you like to do?"
                }
            }
        }
        timeout {
            puts "FAIL: Menu return test did not load"
            exit 1
        }
    }
    
    expect eof
}

# Function to test menu help and information
proc test_menu_help {} {
    global timeout dcutil_cmd
    
    spawn $dcutil_cmd menu
    
    expect {
        "What would you like to do?" {
            # Test help option
            send "10\r"
            
            expect {
                "Usage:" - "help" {
                    puts "PASS: Help option works"
                    send "\r"
                    
                    # Should return to main menu
                    expect "What would you like to do?"
                    
                    # Test exit
                    send "0\r"
                    expect {
                        "Goodbye" {
                            puts "PASS: Help and exit flow works"
                        }
                        timeout {
                            send "\r"
                        }
                    }
                }
                timeout {
                    send "\r"
                    expect "What would you like to do?"
                }
            }
        }
        timeout {
            puts "FAIL: Menu help test did not load"
            exit 1
        }
    }
    
    expect eof
}

# Main execution
puts "📋 Testing dcutil menu functionality..."

# Test main menu navigation
test_main_menu_navigation

# Test features sub-navigation
test_features_subnavigation

# Test menu return functionality
test_menu_return_functionality

# Test menu help
test_menu_help

puts "🎉 All menu tests completed successfully!"
exit 0