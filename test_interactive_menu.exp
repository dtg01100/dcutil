#!/usr/bin/expect

# Test script using expect to validate the new interactive menu system
set timeout 20

# Function to test template selection
set cmd "bash -c {source /var/mnt/Disk2/projects/dcutil/lib/core.sh; source /var/mnt/Disk2/projects/dcutil/lib/template_integration.sh; mock_templates='{\\\"id\\\": \\\"go\\\", \\\"name\\\": \\\"Go\\\", \\\"description\\\": \\\"Official Go programming language container\\\"}, {\\\"id\\\": \\\"python\\\", \\\"name\\\": \\\"Python\\\", \\\"description\\\": \\\"Python development environment\\\"}'; select_template_interactive \"\\\$mock_templates\"; echo \\\"Template result: \\\$?\\\"; echo \\\"Selected template: \\\$user_selected_template\\\"}"

spawn $cmd

expect {
    "Select a template*" {
        send "1\r"
        exp_continue
    }
    "Selected template: go" {
        puts "✓ Template selection test passed"
    }
    timeout {
        puts "✗ Template selection test timed out"
        exit 1
    }
}

# Function to test feature selection
set cmd2 "bash -c {source /var/mnt/Disk2/projects/dcutil/lib/core.sh; source /var/mnt/Disk2/projects/dcutil/lib/template_integration.sh; mock_features='{\\\"id\\\": \\\"git\\\", \\\"name\\\": \\\"Git\\\", \\\"description\\\": \\\"Install Git from source\\\"}, {\\\"id\\\": \\\"common-utils\\\", \\\"name\\\": \\\"Common Utils\\\", \\\"description\\\": \\\"Common command line utilities\\\"}, {\\\"id\\\": \\\"docker-in-docker\\\", \\\"name\\\": \\\"Docker-in-Docker\\\", \\\"description\\\": \\\"Docker Engine and CLI\\\"}'; select_features_interactive \"\\\$mock_features\"; echo \\\"Features result: \\\$?\\\"; echo \\\"Selected features: \\\$user_selected_features\\\"}"

spawn $cmd2

expect {
    "Commands: *" {
        send "s\r"
        exp_continue
    }
    "Enter space-separated numbers*" {
        send "1 2\r"
        exp_continue
    }
    "Continue with these selections*" {
        send "y\r"
        exp_continue
    }
    "*Selected features: *" {
        puts "✓ Feature selection test passed"
    }
    timeout {
        puts "✗ Feature selection test timed out"
        exit 1
    }
}

puts "All interactive menu tests passed!"
