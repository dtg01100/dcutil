#!/usr/bin/expect

# Test script using expect to validate the interactive menu system
set timeout 20

puts "Testing interactive template selection..."

# Test template selection with expect
spawn /var/mnt/Disk2/projects/dcutil/interactive_test_helper.sh template

expect {
    "Select a template*" {
        send "1\r"
        exp_continue
    }
    "RESULT:0" {
        puts "✓ Interactive template selection test passed"
        exp_continue
    }
    "SELECTED:go" {
        puts "✓ Correct template selected in interactive mode"
        exp_continue
    }
    timeout {
        puts "✗ Template selection test timed out"
        exit 1
    }
}

puts "\nTesting interactive feature selection..."

# Test feature selection with expect
spawn /var/mnt/Disk2/projects/dcutil/interactive_test_helper.sh feature

expect {
    "Commands: *" {
        send "s\r"
        exp_continue
    }
    "Enter space-separated numbers*" {
        send "1 2\r"
        exp_continue
    }
    "Continue with these selections*" {
        send "y\r"
        exp_continue
    }
    "RESULT:0" {
        puts "✓ Interactive feature selection test passed"
        exp_continue
    }
    "SELECTED:git,common-utils" {
        puts "✓ Correct features selected in interactive mode"
        exp_continue
    }
    timeout {
        puts "✗ Feature selection test timed out"
        exit 1
    }
}

puts "\nAll interactive tests completed successfully!"
