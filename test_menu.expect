#!/usr/bin/expect

set timeout 30

# Change to test directory if provided
if {$argc >= 1} {
    set test_dir [lindex $argv 0]
    cd $test_dir
}

# Test menu choice 1 (up)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "1\r"
expect {
    "Starting your development environment" { puts "PASS: Menu choice 1" }
    timeout { puts "FAIL: Timeout waiting for menu choice 1"; exit 1 }
}
# # expect eof

# Test menu choice 2 (enter)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "2\r"
expect {
    "Opening a shell in your environment" { puts "PASS: Menu choice 2" }
    timeout { puts "FAIL: Timeout waiting for menu choice 2"; exit 1 }
}
# # expect eof

# Test menu choice 3 (down)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "3\r"
expect {
    "Stopping your environment" { puts "PASS: Menu choice 3" }
    timeout { puts "FAIL: Timeout waiting for menu choice 3"; exit 1 }
}
# # expect eof

# Test menu choice 4 (status)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "4\r"
expect {
    "Checking environment status" { puts "PASS: Menu choice 4" }
    timeout { puts "FAIL: Timeout waiting for menu choice 4"; exit 1 }
}
# # expect eof

