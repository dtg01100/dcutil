expect {
    "Showing resource usage" { puts "PASS: Menu choice 5" }
    timeout { puts "FAIL: Timeout waiting for menu choice 5"; exit 1 }
}
# # expect eof

# Test menu choice 6 (init)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "6\r"
expect {
    "Setting up a new project" { puts "PASS: Menu choice 6" }
    timeout { puts "FAIL: Timeout waiting for menu choice 6"; exit 1 }
}
# # expect eof

# Test menu choice 7 (logs)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "7\r"
expect {
    "Viewing logs" { puts "PASS: Menu choice 7" }
    timeout { puts "FAIL: Timeout waiting for menu choice 7"; exit 1 }
}
# # expect eof

# Test menu choice 8 (volumes)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
