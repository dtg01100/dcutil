# # expect eof

# Test menu choice 9 (help)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "9\r"
# # expect eof
puts "PASS: Menu choice 9 (help)"

# Test menu choice 0 (exit)
spawn /var/home/dlafreniere/projects/dcutil/dcutil-files/dcutil
expect "What would you like to do?"
send "0\r"
expect {
    "Goodbye!" { puts "PASS: Menu choice 0" }
