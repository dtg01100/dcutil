#!/home/linuxbrew/.linuxbrew/bin/expect

# Simple test script for dcutil menu functionality
# Tests basic menu navigation and features menu

set timeout 30
set dcutil_cmd [lindex $argv 0]
if {$dcutil_cmd eq ""} {
    set dcutil_cmd "./dcutil"
}

puts "🧪 Testing dcutil menu functionality..."

# Test main menu loading
spawn $dcutil_cmd menu

expect {
    "What would you like to do?" {
        puts "PASS: Main menu loaded successfully"
        
        # Test features menu
        send "9\r"
        
        expect {
            "Managing devcontainer features..." {
                puts "PASS: Features menu loaded successfully"
                
                # Test view features
                send "3\r"
                
                expect {
                    "Enter search term to filter features" {
                        puts "PASS: Feature search prompt displayed"
                        
                        # Go back
                        send "back\r"
                        
                        expect {
                            "Press Enter to continue viewing" {
                                send "\r"
                                
                                expect {
                                    "Managing devcontainer features..." {
                                        puts "PASS: Returned to features menu"
                                        
                                        # Exit features menu
                                        send "5\r"
                                        
                                        expect {
                                            "Exiting without saving changes" {
                                                puts "PASS: Features menu exit works"
                                                
                                                # Should return to main menu
                                                expect "What would you like to do?"
                                                
                                                puts "PASS: Returned to main menu"
                                                
                                                # Exit main menu
                                                send "0\r"
                                                
                                                expect {
                                                    "Goodbye" {
                                                        puts "PASS: Main menu exit works"
                                                    }
                                                    timeout {
                                                        puts "FAIL: Main menu exit timed out"
                                                        exit 1
                                                    }
                                                }
                                            }
                                            timeout {
                                                puts "FAIL: Features menu exit timed out"
                                                exit 1
                                            }
                                        }
                                    }
                                    timeout {
                                        puts "FAIL: Did not return to features menu"
                                        exit 1
                                    }
                                }
                            }
                            timeout {
                                puts "FAIL: Did not show continue prompt"
                                exit 1
                            }
                        }
                    }
                    timeout {
                        puts "FAIL: Did not reach feature search prompt"
                        exit 1
                    }
                }
            }
            timeout {
                puts "FAIL: Did not reach features menu"
                exit 1
            }
        }
    }
    timeout {
        puts "FAIL: Main menu did not load"
        exit 1
    }
}

expect eof

puts "🎉 Menu functionality test completed successfully!"
exit 0